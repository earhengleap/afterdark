# Media files - DO NOT UPLOAD
/media/
videos/
images/
audio/
*.mp4
*.mp3
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.part
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Telegram session files are NOT ignored per user request to sync across devices
dashboard/media_cache/
!dashboard/media_cache/*.session*
telegram_sessions/
!telegram_sessions/*.session*
data/*.db
data/runtime/
data/twa_public_url.txt
data/*.lock
data/*.pid
users/*.json
config/twitter_cookies.txt
twitter_cookies.txt

# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pythonlibs/

# Log files and data
*.log

# Temporary files
*.tmp
*.temp
.cache/
tests/_tmp/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local git worktrees
.worktrees/
worktrees/

# Replit
# .replit
replit.nix

# Node modules
node_modules/

# Secrets and Environment Variables
.env
.env.*
