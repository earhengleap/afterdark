modules = ["web", "nodejs-20", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = [
  "cacert",
  "cargo",
  "libiconv",
  "libuv",
  "libxcrypt",
  "libyaml",
  "rustc",
  "ffmpeg",
]

[workflows]
runButton = "Telegram Bot"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python afterdark.py"

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "vm"
run = [
  "bash",
  "-c",
  "TWA_AUTOSTART=0 FFMPEG_PATH=/usr/bin/ffmpeg python afterdark.py",
]

[userenv]

[userenv.shared]
